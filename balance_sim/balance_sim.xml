<?xml version='1.0' encoding='utf-8'?>
<!--
  COD-2026 平衡车（串联腿闭链）仿真模型
  来源: https://github.com/GrassFanWang/COD-2026RoboMaster-Balance-Simulation_File
  在官方 MJCF 基础上做的修改（保持官方文件 assets/COD-2026RoboMaster-Balance.xml 原样）:
    1. 新增地面 plane（官方模型没有地面）
    2. 两个车轮 geom 覆盖 conaffinity="1"，使其能与地面接触
       （官方 <default> 是 conaffinity="0"，轮子会直接穿过地面）
    3. 新增环境光
    4. front/rear 大腿关节 range 从 ±1 放宽到 ±3 / ±1.5：
       官方模型的 keyframe(qpos=0) 并不在闭链约束流形上，闭链自然收敛
       要求 front≈±2.46、rear≈±1.07，官方限位与闭环几何不匹配，
       导致仿真中关节被约束拉穿限位。
    5. keyframe 换成闭链收敛得到的闭合位形（见 <keyframe> 注释）。
  其余（腿、关节、闭链 connect 约束、执行器）与官方完全一致。
-->
<mujoco model="COD-2026-Balance-2.0-sim">
  <default>
    <geom contype="1" conaffinity="0"/>
  </default>
  <compiler angle="radian" />
  <asset>
    <mesh name="base_link" file="assets/base_link.STL" />
    <mesh name="Left_front_link" file="assets/Left_front_link.STL" />
    <mesh name="Left_front_child1_link" file="assets/Left_front_child1_link.STL" />
    <mesh name="Left_front_child2_link" file="assets/Left_front_child2_link.STL" />
    <mesh name="Left_front_child3_link" file="assets/Left_front_child3_link.STL" />
    <mesh name="Left_rear_link" file="assets/Left_rear_link.STL" />
    <mesh name="Left_rear_child1_link" file="assets/Left_rear_child1_link.STL" />
    <mesh name="Left_Wheel_link" file="assets/Left_Wheel_link.STL" />
    <mesh name="Right_front_link" file="assets/Right_front_link.STL" />
    <mesh name="Right_front_child1_link" file="assets/Right_front_child1_link.STL" />
    <mesh name="Right_front_child2_link" file="assets/Right_front_child2_link.STL" />
    <mesh name="Right_front_child3_link" file="assets/Right_front_child3_link.STL" />
    <mesh name="Right_rear_link" file="assets/Right_rear_link.STL" />
    <mesh name="Right_rear_child1_link" file="assets/Right_rear_child1_link.STL" />
    <mesh name="Right_Wheel_link" file="assets/Right_Wheel_link.STL" />
  </asset>
  <worldbody>
    <light diffuse="0.6 0.6 0.6" pos="0 -1 3" dir="0 0.4 -1"/>
    <geom name="ground" type="plane" size="10 10 0.1" rgba="0.42 0.46 0.5 1" friction="1.0 0.1 0.1"/>
    <geom type="mesh" rgba="1 1 1 1" mesh="base_link" />

    <body name="Left_front_link" pos="-0.0193914 -0.1837 -0.05">
      <inertial pos="0.032009 -0.002932 -0.003563" quat="0.472786 0.528055 0.525808 0.470275" mass="0.7" diaginertia="0.000152893 0.000125485 2.9469e-05" />
      <joint name="Left_front_joint" pos="0 0 0" axis="0 1 0" damping="0.1"  range="-3 3"/>
      <geom type="mesh" rgba="0.89804 0.91765 0.92941 1" mesh="Left_front_link" />

      <body name="Left_front_child1_link" pos="0.0993862 0.00145 -0.011063">
        <inertial pos="-0.038168 0.0023981 -0.022193" quat="0.612915 0.352613 0.352613 0.612915" mass="0.25" diaginertia="5.3755e-05 5.27361e-05 1.58089e-06" />
        <joint name="Left_front_child1_joint" pos="0 0 0" axis="0 1 0" damping="0.02"  range="-1.35 0"/>
        <geom type="mesh" rgba="1 1 1 1" mesh="Left_front_child1_link" />

        <body name="Left_front_child2_link" pos="-0.10213 0.00 -0.0593844">
          <inertial pos="-0.070408 -0.0065 0.055735" quat="0.300789 0.639942 0.639942 0.300789" mass="0.45" diaginertia="0.00027733 0.000261923 1.71071e-05" />
          <joint name="Left_front_child2_joint" pos="0 0 0" axis="0 1 0" damping="0.02"  range="0 0.98"/>
          <site name="Left_front_site1" pos="-0.098 -0.002 0.0665" size="0.005" rgba="1 0 0 1"/>
          <geom type="mesh" rgba="1 1 1 1" mesh="Left_front_child2_link" />


          <body name="Left_front_child3_link" pos="-0.131927 0.001 0.116079">
            <inertial pos="-0.056516 0.0047872 -0.0018655" quat="0.50818 0.491683 0.491683 0.50818" mass="0.25" diaginertia="4.8247e-05 4.75555e-05 1.17022e-06" />
            <joint name="Left_front_child3_joint" pos="0 0 0" axis="0 1 0" damping="0.02"  range="-1.3 0"/>
            <site name="Left_front_site2" pos="-0.115 0 -0.005" size="0.005" rgba="1 0 0 1"/>
            <geom type="mesh" rgba="1 1 1 1" mesh="Left_front_child3_link" />

          </body>
        </body>
      </body>
    </body>

    <body name="Left_rear_link" pos="-0.0193914 -0.1597 -0.05">
      <inertial pos="-0.088717 -0.014548 -0.002836" quat="0.504264 0.494926 0.493803 0.506877" mass="0.7" diaginertia="0.0015394 0.00142065 0.000124696" />
      <joint name="Left_rear_joint" pos="0 0 0" axis="0 -1 0" damping="0.1"  range="-1.5 1.5"/>
      <site name="Left_rear_site1" pos="-0.1005 -0.025 -0.0035" size="0.005" rgba="1 1 0 1"/>
      <geom type="mesh" rgba="1 1 1 1" mesh="Left_rear_link" />


      <body name="Left_rear_child1_link" pos="-0.214883 -0.0235 -0.00709287">
        <inertial pos="0.077559 -0.0084721 -0.050638" quat="0.322031 0.62952 0.62952 0.322031" mass="0.75" diaginertia="0.0026525 0.00255923 9.97263e-05" />
        <joint name="Left_rear_child1_joint" pos="0 0 0" axis="0 1 0" damping="0.05" range="0 1.35"/>
        <site name="Left_rear_site2" pos="-0.038 0 0.05" size="0.005" rgba="1 1 0 1"/>
        <geom type="mesh" rgba="1 1 1 1" mesh="Left_rear_child1_link" />

        <body name="Left_Wheel_link" pos="0.208983 -0.02455 -0.144368">
          <inertial pos="0.00015229 -0.0099965 -0.00013677" quat="0.583036 0.400153 0.400171 0.582932" mass="0.9" diaginertia="0.00043712 0.000230405 0.000228895" />
          <joint name="Left_Wheel_joint" pos="0 0 0" axis="0 1 0" damping="0.01" />
          <geom type="mesh" rgba="0.79216 0.81961 0.93333 1" mesh="Left_Wheel_link" contype="1" conaffinity="1"/>

        </body>
      </body>
    </body>

    <body name="Right_front_link" pos="-0.0193914 0.1817 -0.05">
      <inertial pos="0.025832 0.0043356 -0.0054908" quat="0.443683 0.548461 0.550587 0.446308" mass="0.7" diaginertia="0.000152213 0.00012511 2.90948e-05" />
      <joint name="Right_front_joint" pos="0 0 0" axis="0 -1 0" damping="0.1" range="-3 3" ref="-0.1"/>
      <geom type="mesh" rgba="0.89804 0.91765 0.92941 1" mesh="Right_front_link" />

      <body name="Right_front_child1_link" pos="0.0978147 0.00055 -0.0207914">
        <inertial pos="-0.050846 -0.0047941 -0.028159" quat="0.609195 0.359001 0.359001 0.609195" mass="0.25" diaginertia="5.3061e-05 5.23561e-05 1.19993e-06" />
        <joint name="Right_front_child1_joint" pos="0 0 0" axis="0 1 0" damping="0.02" range="-1.35 0 "/>
        <geom type="mesh" rgba="1 1 1 1" mesh="Right_front_child1_link" />

        <body name="Right_front_child2_link" pos="-0.103349 0.002 -0.0572359">
          <inertial pos="-0.067449 0.006444 0.058262" quat="0.287002 0.646243 0.646243 0.287002" mass="0.45" diaginertia="0.00027735 0.000261944 1.71164e-05" />
          <joint name="Right_front_child2_joint" pos="0 0 0" axis="0 -1 0" damping="0.02" range="-0.98 0"/>
          <site name="Right_front_site1" pos="-0.0948 -0.002 0.071" size="0.005" rgba="1 0 0 1"/>
          <geom type="mesh" rgba="0.77647 0.75686 0.73725 1" mesh="Right_front_child2_link" />

          <body name="Right_front_child3_link" pos="-0.126832 -0.001 0.121624">
            <inertial pos="-0.056417 -0.0047872 -0.0038317" quat="0.516662 0.482763 0.482763 0.516662" mass="0.25" diaginertia="4.8247e-05 4.7555e-05 1.17023e-06" />
            <joint name="Right_front_joint3_joint" pos="0 0 0" axis="0 -1 0" damping="0.02" />
            <site name="Right_front_site2" pos="-0.115 0 -0.007" size="0.005" rgba="1 0 0 1"/>
            <geom type="mesh" rgba="1 1 1 1" mesh="Right_front_child3_link" />

          </body>
        </body>
      </body>
    </body>

    <body name="Right_rear_link" pos="-0.0193914 0.1597 -0.05">
      <inertial pos="-0.088564 0.014548 -0.0059225" quat="0.515415 0.48495 0.486028 0.512784" mass="0.7" diaginertia="0.0015394 0.00142064 0.000124697" />
      <joint name="Right_rear_joint" pos="0 0 0" axis="0 1 0" damping="0.1" range="-1.5 1.5" ref="0.0"/>
      <site name="Right_rear_site1" pos="-0.1 0.0225 -0.008" size="0.005" rgba="1 1 0 1"/>
      <geom type="mesh" rgba="1 1 1 1" mesh="Right_rear_link" />

      <body name="Right_rear_child1_link" pos="-0.214506 0.0235 -0.0145685">
        <inertial pos="0.079808 0.0083536 -0.058254" quat="0.308464 0.636278 0.636278 0.308464" mass="0.75" diaginertia="0.0026518 0.00255881 9.92948e-05" />
        <joint name="Right_rear_child1_joint" pos="0 0 0" axis="0 -1 0" damping="0.05" range="-1.35 0" />
        <site name="Right_rear_site2" pos="-0.035 0 0.05" size="0.005" rgba="1 1 0 1"/>
        <geom type="mesh" rgba="1 1 1 1" mesh="Right_rear_child1_link" />

        <body name="Right_Wheel_link" pos="0.202605 0.02455 -0.15319">
          <inertial pos="0.00017762 0.0099965 -0.00010174" quat="0.706853 0.0171001 0.0170535 0.706948" mass="0.9" diaginertia="0.00043712 0.000230404 0.000228896" />
          <joint name="Right_Wheel_joint" pos="0 0 0" axis="0 -1 0" damping="0.01"/>
          <geom type="mesh" rgba="0.79216 0.81961 0.93333 1" mesh="Right_Wheel_link" contype="1" conaffinity="1"/>

        </body>
      </body>
    </body>
  </worldbody>

  <equality>
      <connect name="Left_loop1" site1="Left_front_site1" site2="Left_rear_site1" solref="0.001 1" solimp="0.99 0.99 0.01 0.5 2"/>
      <connect name="Left_loop2" site1="Left_front_site2" site2="Left_rear_site2" solref="0.001 1" solimp="0.99 0.99 0.01 0.5 2"/>
      <connect name="Right_loop1" site1="Right_front_site1" site2="Right_rear_site1" solref="0.001 1" solimp="0.99 0.99 0.01 0.5 2"/>
      <connect name="Right_loop2" site1="Right_front_site2" site2="Right_rear_site2" solref="0.001 1" solimp="0.99 0.99 0.01 0.5 2"/>
    </equality>

  <actuator>
    <general name="Left_front_joint_actuator" joint="Left_front_joint" gainprm="1" ctrlrange="-3.14 3.14" />
    <general name="Left_rear_joint_actuator" joint="Left_rear_joint" gainprm="1" ctrlrange="-3.14 3.14" />
    <general name="Left_Wheel_joint_actuator" joint="Left_Wheel_joint" gainprm="1" />
    <general name="Right_front_joint_actuator" joint="Right_front_joint" gainprm="1" ctrlrange="-3.14 3.14" />
    <general name="Right_rear_joint_actuator" joint="Right_rear_joint" gainprm="1" ctrlrange="-3.14 3.14" />
    <general name="Right_Wheel_joint_actuator" joint="Right_Wheel_joint" gainprm="1" ctrlrange="-3.14 3.14" />
  </actuator>
  <keyframe>
    <!-- 闭合位形：官方 keyframe 的 qpos=0 并不在闭链约束流形上（初始残差 ~4mm），
         这是让闭链自然收敛后得到的位形（front/rear 大角度是该闭环几何的真实解） -->
    <key name="home" qpos="2.4601 -1.0493 0.7158 -1.0286 -1.0687 1.1211 0 -2.4910 -1.0480 -0.7569 1.0409 1.0553 -1.1194 0" />
  </keyframe>
</mujoco>
